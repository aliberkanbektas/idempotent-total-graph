title: "Idempotent total graphs of the rings Z_n: code for computation, verification and visualization"
version: 1.0.0
date-released: 2026-09-26
license: MIT
authors:
  - family-names: Kara
    given-names: Yeliz
    affiliation: "Bursa Uludağ University, Department of Mathematics"
  - family-names: Bektaş
    given-names: Ali Berkan
